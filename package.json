{
  "name": "simple-badge",
  "version": "1.0.0",
  "private": true,
  "description": "Insert simple colored HTML badges from the Obsidian editor context menu.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/test.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dev": "node scripts/deploy.mjs D:/Notes/Develop"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "entities": "8.1.0"
  }
}
